\section{Preliminarii}
\subsection{Ecuații și sisteme de ecuații diferențiale}
\begin{definition}
    Numim \textit{ecuație diferențială} o relație între o funcție necunoscută,
    derivatele sale și variabilele independente. Dacă într-o ecuație diferențială
    găsim doar derivate ordinare ale funcției necunoscute, iar acestea sunt în relație
    de dependență cu o singură variabilă independentă, atunci ecuația se numeșste ecuație 
    diferențială ordinară.
Forma generală a unei ecuații diferențiale de ordin n: 
\begin{equation}
    \label{1.1.1}
     F(t, x(t), x^{'}(t), \dots, x^{(n)}(t)) = 0
\end{equation}
unde $t\in J\subseteq\mathbb{R}$ si $F:J\times\mathbb{R}^{n}\times\dots\times\mathbb{R}^{n}$

\end{definition}

\begin{definition}
     Fie $f:D\subseteq\mathbb{R}\times\mathbb{R}^{n}\rightarrow\mathbb{R}^{n}$ o funcție continuă. Printr-o ecuație diferențială de ordin I înțelegem:
     \begin{equation}
         \label{1.1.1}
         x^{'}(t) = f(t,x(t))
     \end{equation}
     unde $x = x(t)$ este necunoscuta.
\end{definition}

\begin{definition}
    \textit{Spunem că funcția $\varphi: I \rightarrow \mathbb{R}$ este soluție a ecuației 1.2.2 pe intervalul $I \subseteq D$ dacă satisface următoarele proprietăți:}
    \begin{enumerate}
        \item[$(i)$] $\forall t \in I (t, \varphi(t)) \in D$;
        \item [$(ii)$] $\varphi$ e derivabila pe I;
        \item [$(iii)$]$\varphi^{'}(t) = f(t, \varphi(t))$, $\forall t \in I$.
    \end{enumerate}
    \textit{Există trei tipuri de soluții}
    \begin{enumerate}
        \item Soluție explicită
        \item Soluție implicită
        \item Soluție în formă parametrică
    \end{enumerate}

\end{definition}

\begin{definition}
    O ecuație de forma \begin{equation}
        F(t, x(t), x^{'}(t), \dots, x^{n}(t)) = 0
    \end{equation} unde $t \in J \subseteq \mathbb{R}$, iar $F:J\times\mathbb{R}^{n}\times\dots\times\mathbb{R}^{n}\rightarrow\mathbb{R}^{n}$ se numește ecuație diferențială de ordin n.
\end{definition}

\begin{definition}
    Sisteme de ecua\c{t}ii diferen\c{t}iale. Forma general\u{a} a unui sistem de $n$ ecua\c{t}ii diferen\c{t}iale de ordinul \^intai \^in form\u{a} normal\u{a} este:
\end{definition}
\begin{equation}
\label{1.1.1}
\left\{\ba{ll}
		x_{1}^{'}(t)= f_{1}(t,x_{1}(t),...,x_{n}(t)) \\
        x_{2}^{'}(t)= f_{2}(t,x_{1}(t),...,x_{n}(t)) \\
        \vdots \\
        x_{n}^{'}(t)= f_{n}(t,x_{1}(t),...,x_{n}(t))
\ea\right.
\end{equation}       
         
\textit{Dac\u{a} not\u{a}m $x=(x_{1},...,x_{n})$ ,$ f=(f_{1},...,f_{n})$, se ob\c{t}ine forma vectorial\u{a} a sistemului:}
\begin{equation}
\label{1.2.6}
x^{'}(t)=f(t,x(t))
\end{equation}
unde $f:D_{f}\rightarrow\mathbb{R}^{n}$, $ D_{f}\subseteq\mathbb{R}^{n+1} $\\

\begin{remark}
    Sistemul \ref{1.1.1} este liniar dacă $\forall i \in [1,n]$ funcțiile $f_{i}$ sunt liniare. În caz contrar, sistemul este neliniar.
\end{remark}
    Putem trece sistemul de ecuații diferențiale în formă matriceală, făcând următoarele notații:

\[
A = \begin{pmatrix}
a_{11}(t) & a_{12}(t) & \cdots & a_{1n}(t) \\
a_{21}(t) & a_{22}(t) & \cdots & a_{2n}(t) \\
\vdots & \vdots & \ddots & \vdots \\
a_{n1}(t) & a_{n2}(t) & \cdots & a_{nn}(t)
\end{pmatrix},
\quad
X = \begin{pmatrix}
x_1 \\
x_2 \\
\vdots \\
x_n
\end{pmatrix}
\quad \text{și} \quad
F = \begin{pmatrix}
f_1 \\
f_2 \\
\vdots \\
f_n
\end{pmatrix},
\]
\\

Astfel sistemul se poate scrie în felul următor:
\begin{equation}
    X^{'} = A\cdot X + F
\end{equation}

\begin{definition}
\label{d1.2.9}
\textit{O func\c{t}ie $x:I\rightarrow\mathbb{R}^n$ se nume\c{s}te \textbf{solu\c{t}ie a sistemului} de ecua\c{t}ii dac\u{a} sunt \^indeplinite urm\u{a}toarele condi\c{t}ii:\\
\hspace*{5mm}$(i)$ $I\subseteq\mathbb{R}$ este un interval nedegenerat;\\
\hspace*{5mm}$(ii)$ $x\in C^{1}(I,\mathbb{R}^n)$ \c{s}i $(t,x(t))\in D_{f}$ , $\forall t\in I$ ;\\
\hspace*{5mm}$(iii)$ $x^{'}(t)=f(t,x(t))$, $\forall t\in I $}
\end{definition}


\begin{definition}
    O ecuație diferențială de ordin I sub forma $x^{'}(t) = f(t,x)$ poate fi interpretată geometric ca un câmp vectorial în planul delimitat de domeniul lui f. Pentru fiecare punct de coordonate $(t_{0}, x_{0}) \in D_{f}$ asociem o direcție de viteză unghiulară $f(t_{0}, x_{0})$.Curbele $\Gamma$, de clas\u{a} $C^{1}$ din $D_{f}$, se numesc curbe integrale ale c\^{a}mpului vectorial $f$ dac\u{a} oricare ar fi un punct $(t,x)\in \Gamma$ vectorul c\^{a}mpului $f$ \^in acest punct este tangent la curba $\Gamma$. 
\end{definition}

