\end{example}
\section{Modelul logistic de creștere al lui Verhulst}

\hspace*{10mm}Modelul logistic de cresștere a populației a fost introdus de către Pierre Francois(c cu accent) Verhulst într-o serie de trei lucrări publicate între 1838 și 1847. Acest model presupune că există o constantă de suport a mediului numită K, care reprezintă un nivel stabil al populației. Dacă populația este mai mică decât $K$, ea va crește, iar în caz contrar va scădea.\\
\hspace*{10mm}Considerăm din nou $y = \phi(t)$ numărul de indivizi ai speciei la momentul t și $r$ rata de schimbare a densității populației.

\begin{equation*}
    \frac{dy}{dt} = r\cdot y\cdot(1 - \frac{y}{k})
\end{equation*}

\hspace*{10mm}Vom rezolva modelul parcurgând următorii pași
\begin{enumerate}
    \item Impunem condția inițială:
    \begin{equation*}
        y(0) = y_{0}
    \end{equation*}
    \item Rescriem ecuația și separăm termenii care îl conțin pe y în partea dreaptă
    \begin{equation*}
        \frac{dy}{dt} = r\cdot y\cdot(1 - \frac{y}{k}) \iff \frac{dy}{dt} = \frac{r\cdot y}{k}\cdot(k - y) \iff \frac{dy}{y\cdot (k - y)} = \frac{r\cdot dt}{k}
    \end{equation*}
    \item Integrăm ambele părți
    \begin{equation*}
        \int \frac{dy}{y\cdot (k - y)} = \int \frac{r\cdot dt}{k} \iff \frac{1}{k}\cdot (\int \frac{dy}{y} + \int \frac{dy}{k - y}) = \frac{1}{k}\cdot\int\ r\cdot dt  \iff 
    \end{equation*}
    \begin{equation*}
        \frac{1}{k}\cdot(\ln{y} - \ln{(k-y)}) = \frac{r}{k}\cdot t + c, c\in             \mathbb{R}
    \end{equation*}
    \item Aplicăm condiția inițială ca să obținem constanta $c$
    \begin{equation*}
        \frac{1}{k}\cdot(\ln{y_{0}} - \ln{(k-y_{0})}) = c
    \end{equation*}
    \item Înlocuim $c$ în ecuație și îl aflăm pe $y$
    \begin{equation*}
         \frac{1}{k}\cdot(\ln{y} - \ln{(k-y)}) = \frac{r}{k}\cdot t + \frac{1}{k}\cdot(\ln{y_{0}} - \ln{(k-y_{0})})
    \end{equation*}
    \begin{equation*}
         \iff \ln{\frac{y}{k-y}} = r\cdot t + \ln{\frac{y_{0}}{k-y_{0}}} \iff \ln{\frac{y\cdot(k-y_{0})}{y_{0}\cdot(k-y)}} = r\cdot t 
    \end{equation*}
    \begin{equation*}
        \iff y\cdot(k-y_{0}) = e^{r\cdot t}\cdot y_{0}\cdot(k-y) \iff y\cdot (k-y_{0} + y_{0}\cdot e^{r\cdot t}) = k\cdot y_{0}\cdot e^{r\cdot t}
    \end{equation*}

    \item În final, ajungem la următorul rezultat
    \begin{equation*}
        y = \frac{k\cdot y_{0}\cdot e^{r\cdot t}}{y_{0}+(k - y_{0})\cdot e^{-r\cdot t}}
    \end{equation*}
    
    \end{enumerate}


